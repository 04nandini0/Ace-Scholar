# Copy this file to `.env` for local development. NEVER commit `.env`.
# On Zerops (or any host) set these in the service's environment variables instead.

# Required for screenshot analysis and AI-assisted question understanding.
# Get a key at https://aistudio.google.com/apikey
# Without it, typed questions still work using the verified route database.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional (defaults shown)
# GEMINI_MODEL=gemini-2.5-flash
# PORT=3000
# AI_TIMEOUT_MS=25000
# AI_RETRIES=1
# RATE_LIMIT_PER_MIN=30
# Comma-separated origins allowed to call /api from another site. Empty = same-origin only.
# ALLOWED_ORIGINS=
